# Server only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
STRIPE_SECRET_KEY=sk_test_YOUR_TEST_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET
SITE_URL=http://localhost:3000

# Admin dashboard (/admin). Also server only: sign-in runs on the server, never in the browser.
# Supabase -> Project Settings -> API Keys -> publishable key (the legacy anon key also works).
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Comma-separated emails allowed into /admin (each must also exist as a confirmed Supabase Auth user,
# created by hand). Everyone else gets a 404. SITE_URL above is required for sign-in links.
ADMIN_EMAILS=founder1@example.com,founder2@example.com

# Concierge pilot (/admin/concierge + Telegram bot). Each part switches itself off while its vars
# are missing. The console uses the admin sign-in above: same ADMIN_EMAILS, same session.
# Telegram intake bot. Token from @BotFather; secret is 32+ chars of [A-Za-z0-9_-] (openssl rand -hex 32).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Bot username without @, used for one-tap invite links (t.me/<bot>?start=CODE).
TELEGRAM_BOT_USERNAME=
# Claude drafting (claude-sonnet-5-5).
ANTHROPIC_API_KEY=

# Confirmation email after the $1 payment, sent through Resend (resend.com). Optional: while either
# of the first two is unset, no email is sent. EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=NoSwipe <hi@noswipe.app>
# Optional: where replies go, if not the EMAIL_FROM address.
EMAIL_REPLY_TO=

# Observability. All optional: leave unset and Sentry/PostHog stay off. See DEPLOYMENT.md.
# Server-side Sentry DSN, read at runtime.
SENTRY_DSN=
# Browser keys. Public by design (they ship in the page) and inlined at BUILD time.
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Source-map upload at build time. Without all three, upload is skipped and the build still passes.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Commit SHA reported by /api/health and used as the Sentry release name.
GIT_SHA=

# Ops alerts into the founders' Telegram forum group (signups, payments, errors, daily digest).
# Optional: while either is unset, nothing is posted. Bot token from @BotFather; chat id is negative.
NOSWIPE_OPS_BOT_TOKEN=
NOSWIPE_OPS_CHAT_ID=
# Protects /api/cron/digest. Vercel cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
