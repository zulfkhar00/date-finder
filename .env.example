# Server only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
STRIPE_SECRET_KEY=sk_test_YOUR_TEST_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET
SITE_URL=http://localhost:3000

# Admin dashboard (/admin). Also server only: sign-in runs on the server, never in the browser.
# Supabase -> Project Settings -> API Keys -> publishable key (the legacy anon key also works).
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# Comma-separated emails allowed into /admin (each must also exist as a confirmed Supabase Auth user,
# created by hand). Everyone else gets a 404. SITE_URL above is required for sign-in links.
ADMIN_EMAILS=founder1@example.com,founder2@example.com
